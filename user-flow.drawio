<mxfile host="app.diagrams.net">
  <diagram id="simple-hardware-classification" name="Классификация средств">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Корень -->
        <mxCell id="node_root" value="Классификация средств обработки информации" style="rounded=0;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="40" width="300" height="50" as="geometry" />
        </mxCell>
        
        <!-- Уровень 1 -->
        <mxCell id="node_micro" value="Микрокомпьютеры (включая ПК)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="140" width="200" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="node_main" value="Мэйнфреймы" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="140" width="200" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="node_super" value="Суперкомпьютеры" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="750" y="140" width="200" height="50" as="geometry" />
        </mxCell>
        
        <!-- Уровень 2 (Разветвление ПК) -->
        <mxCell id="node_static" value="Стационарные ПК (Настольные)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="190" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="node_mobile" value="Мобильные ПК (Ноутбуки, КПК)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="240" width="190" height="50" as="geometry" />
        </mxCell>
        
        <!-- Стрелки -->
        <mxCell id="edge1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node_root" target="node_main" />
        <mxCell id="edge2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="node_root" target="node_micro" />
        <mxCell id="edge3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="node_root" target="node_super" />
        
        <mxCell id="edge4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node_micro" target="node_static" />
        <mxCell id="edge5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="node_micro" target="node_mobile" />
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
