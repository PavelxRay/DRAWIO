<mxfile host="app.diagrams.net">
  <diagram id="computing-history" name="Средства обработки информации">
    <mxGraphModel dx="1422" dy="1342" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- БЛОК 1: СРЕДСТВА ОБРАБОТКИ -->
        <mxCell id="m_root" value="Средства обработки информации" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111827;fontColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="460" y="40" width="280" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="c_micro" value="Микрокомпьютеры&lt;br&gt;&lt;br&gt;• Наличие микропроцессора&lt;br&gt;• Универсальное применение&lt;br&gt;• Включают в себя класс ПК" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e3a8a;fontColor=#ffffff;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="160" y="130" width="240" height="100" as="geometry" />
        </mxCell>
        
        <mxCell id="c_main" value="Мэйнфреймы&lt;br&gt;&lt;br&gt;• Научно-технические задачи&lt;br&gt;• Организация от 200 рабочих мест&lt;br&gt;• Совместная работа под одной ОС" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b45309;fontColor=#ffffff;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="480" y="130" width="240" height="100" as="geometry" />
        </mxCell>
        
        <mxCell id="c_super" value="Суперкомпьютеры&lt;br&gt;&lt;br&gt;• Скорость выше 100 МФЛОПС&lt;br&gt;• Высокопараллельная структура&lt;br&gt;• Задачи обороны и большой науки" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#991b1b;fontColor=#ffffff;align=left;spacingLeft=10;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="130" width="240" height="100" as="geometry" />
        </mxCell>
        
        <!-- БЛОК 2: КЛАССИФИКАЦИЯ ПК -->
        <mxCell id="pc_root" value="Персональные компьютеры (ПК)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5b21b6;fontColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="460" y="280" width="280" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="pc_static" value="Стационарные (настольные)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1e40af;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="240" y="370" width="260" height="40" as="geometry" />
        </mxCell>
        
        <mxCell id="st_base" value="Базовые настольные ПК&lt;br&gt;• Desktop — универсальные машины&lt;br&gt;• Применение: дом, стационарный офис" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;fontColor=#0f172a;align=left;spacingLeft=8;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="240" y="430" width="260" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="st_spec" value="Специализированные ПК&lt;br&gt;• Высокопроизводительные рабочие станции&lt;br&gt;• Серверы и суперкомпьютерные системы" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;fontColor=#0f172a;align=left;spacingLeft=8;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="240" y="510" width="260" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="pc_mobile" value="Мобильные (переносные)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#065f46;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="370" width="260" height="40" as="geometry" />
        </mxCell>
        
        <mxCell id="mob_lap" value="Ноутбуки / Laptops / Notebooks&lt;br&gt;• Полноценный ПК в портативном корпусе&lt;br&gt;• Применение: работа на выездах" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;fontColor=#0f172a;align=left;spacingLeft=8;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="700" y="430" width="260" height="60" as="geometry" />
        </mxCell>
        
        <mxCell id="mob_palm" value="Карманные устройства (Palmtops)&lt;br&gt;• Смартфоны-компьютеры, КПК, планшеты&lt;br&gt;• Применение: мобильный учет данных" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;fontColor=#0f172a;align=left;spacingLeft=8;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="700" y="510" width="260" height="60" as="geometry" />
        </mxCell>
        
        <!-- БЛОК 3: ПОКОЛЕНИЯ ЭВМ -->
        <mxCell id="gen_root" value="Поколения ЭВМ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#374151;fontColor=#ffffff;strokeColor=none;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="460" y="620" width="280" height="50" as="geometry" />
        </mxCell>
        
        <mxCell id="g1" value="I поколение (до конца 1950-х)&lt;br&gt;• Элементная база: электронные лампы&lt;br&gt;• Низкая надежность, огромные габариты&lt;br&gt;• Пример: ЭНИАК (1946 г.)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;fontColor=#0f172a;align=left;spacingLeft=8;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="160" y="700" width="410" height="70" as="geometry" />
        </mxCell>
        
        <mxCell id="g2" value="II поколение (до середины 1960-х)&lt;br&gt;• Элементная база: полупроводниковые транзисторы&lt;br&gt;• Снижение веса, стоимости и энергопотребления&lt;br&gt;• Рост общей производительности" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;fontColor=#0f172a;align=left;spacingLeft=8;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="630" y="700" width="410" height="70" as="geometry" />
        </mxCell>
        
        <mxCell id="g3" value="III поколение (до начала 1970-х)&lt;br&gt;• Элементная база: интегральные схемы (ИС)&lt;br&gt;• Появление развитых ОС и мультипрограммирования&lt;br&gt;• Полная программная совместимость машин" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;fontColor=#0f172a;align=left;spacingLeft=8;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="160" y="790" width="410" height="70" as="geometry" />
        </mxCell>
        
        <mxCell id="g4" value="IV поколение (с 1971 г. по н.в.)&lt;br&gt;• Элементная база: большие интегральные схемы (БИС)&lt;br&gt;• Изобретение микропроцессора, развитие СУБД и сетей&lt;br&gt;• Многопроцессорные и многомашинные комплексы" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8fafc;fontColor=#0f172a;align=left;spacingLeft=8;strokeColor=#cbd5e1;" vertex="1" parent="1">
          <mxGeometry x="630" y="790" width="410" height="70" as="geometry" />
        </mxCell>
        
        <!-- ЛИНИИ СВЯЗИ -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#94a3b8;" edge="1" parent="1" source="m_root" target="c_main" />
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;strokeColor=#94a3b8;" edge="1" parent="1" source="m_root" target="c_micro" />
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;strokeColor=#94a3b8;" edge="1" parent="1" source="m_root" target="c_super" />
        
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.25;exitY=1;entryX=0.5;entryY=0;strokeColor=#94a3b8;" edge="1" parent="1" source="pc_root" target="pc_static" />
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.75;exitY=1;entryX=0.5;entryY=0;strokeColor=#94a3b8;" edge="1" parent="1" source="pc_root" target="pc_mobile" />
        
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#cbd5e1;" edge="1" parent="1" source="pc_static" target="st_base" />
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#cbd5e1;" edge="1" parent="1" source="pc_static" target="st_spec" />
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#cbd5e1;" edge="1" parent="1" source="pc_mobile" target="mob_lap" />
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#cbd5e1;" edge="1" parent="1" source="pc_mobile" target="mob_palm" />
